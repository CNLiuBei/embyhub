FROM golang:1.24.3-alpine AS builder

WORKDIR /build
COPY backend/ ./
RUN go mod tidy && go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o emby-proxy ./cmd/emby-proxy

FROM alpine:latest
RUN apk --no-cache add ca-certificates tzdata
ENV TZ=Asia/Shanghai

WORKDIR /app
COPY --from=builder /build/emby-proxy .

# 复制默认配置文件（Docker环境专用）
COPY docker/config/config.yaml ./config/config.yaml

RUN mkdir -p logs

EXPOSE 54682
CMD ["./emby-proxy"]
