FROM golang:1.23-alpine AS builder

WORKDIR /build
COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o emby-proxy ./cmd/emby-proxy

FROM alpine:latest
RUN apk --no-cache add ca-certificates tzdata
ENV TZ=Asia/Shanghai

WORKDIR /app
COPY --from=builder /build/emby-proxy .
COPY backend/config/config.yaml ./config/

RUN mkdir -p logs

EXPOSE 54682
CMD ["./emby-proxy"]
